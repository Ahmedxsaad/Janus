[Unit]
Description=modelguard watch, continuous
# No After=docker-quickstart or similar ordering dependency. GMS can take
# well over a minute to become reachable after boot (JAR extraction, the
# service-mesh of its own containers coming up), and getting that ordering
# exactly right is fragile compared to the alternative: modelguard watch
# fails fast and loudly with a clear DataHubConnectionError when GMS is not
# yet reachable (modelguard/client.py), and Restart=always with a real
# RestartSec below turns that into a self-healing retry rather than a
# one-shot failure. This is the same design law the CLI itself follows:
# exit 2 (could not tell) is never mistaken for exit 1 (a real finding), so
# leaning on it here is not a shortcut, it is reusing a boundary the code
# already draws correctly.
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=azureuser
WorkingDirectory=/opt/modelguard/DataHub
# Clear any container still holding the name before claiming it. `-` so a
# clean start, where there is nothing to remove, is not a failure. This is the
# line that makes the unit restartable at all: a container started by an
# earlier invocation can outlive the systemd process that launched it, and
# then every ExecStart forever after dies on a name conflict rather than
# recovering. Observed on the live VM (D-073), not theorised: `systemctl stop`
# left the container Up, and the service sat in activating/auto-restart
# retrying the same conflict every RestartSec. Restart=always cannot heal a
# failure whose cause is still running.
ExecStartPre=-/usr/bin/docker rm -f modelguard-watch-live
# docker compose run (no -d): stays in the foreground for as long as the
# container runs, so systemd's own process supervision is watching the real
# thing, not a detached container it has to poll for separately.
ExecStart=/usr/bin/docker compose run --rm --name modelguard-watch-live modelguard-watch --table loans_raw --model credit_risk_v3 --interval 30
# Plain `docker stop` against the container name we set ourselves, not
# `docker compose stop`, which takes a *service* name and answers "no such
# service" for a one-off `compose run` container: it stopped nothing, silently,
# which is how a container came to outlive its unit in the first place (D-068
# saw the symptom and read it as an async-cleanup race; it is not).
ExecStop=/usr/bin/docker stop modelguard-watch-live
Restart=always
# Not the default (100ms): GMS being briefly unreachable during its own
# startup is the expected first failure, not an exceptional one, and
# restarting into the same failure every 100ms would just spam the log
# without buying anything back.
RestartSec=15

[Install]
WantedBy=multi-user.target
