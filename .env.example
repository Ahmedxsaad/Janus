# Copy to .env and fill in your own values. .env is git-ignored: never commit it.
# Every value here is personal or machine-specific. Do not put shared config here.

# Local DataHub Quickstart (GMS API). UI runs at http://localhost:9002
DATAHUB_GMS_URL=http://localhost:8080

# Personal access token. Generate in the DataHub UI: Settings -> Access Tokens.
# Required for write operations. Scope it least-privilege, rotate it, never share it.
DATAHUB_GMS_TOKEN=

# Bring-your-own LLM key (Claude via langchain-anthropic).
ANTHROPIC_API_KEY=

# Required to expose MCP write tools (tags, terms, documents, ...).
TOOLS_IS_MUTATION_ENABLED=true
