# Copy to .env and fill in your own values. .env is git-ignored: never commit it.
#
#   cp .env.example .env
#
# Copied as-is, this file runs the full demo against a local DataHub Quickstart:
# every key below is either pre-filled with a value that is correct everywhere,
# or optional and safe to leave blank. Keep the two files in step. If you add a
# key to .env, add it here too, with an empty value and a comment.
#
# ModelGuard reads these only through modelguard/env.py, which is the one place
# that loads this file. Nothing else touches os.environ.
#
# There are no fallbacks for values that identify a system, an account, or a
# vendor: a server URL, a credential, an LLM provider, a model name. A default
# compiled into the package would be a machine-specific value in tracked code,
# and it would turn a missing .env into a silent connection to the wrong place,
# or a silent call to the wrong vendor's API. Missing means missing, loudly.
# Thresholds are different: they are documented product defaults, and blank here
# means "use the default in modelguard/config.py".

# ---------------------------------------------------------------------------
# DataHub connection
# ---------------------------------------------------------------------------

# Required. Local DataHub Quickstart (GMS API). The UI runs at http://localhost:9002
DATAHUB_GMS_URL=http://localhost:8080

# Personal access token. Required only when the DataHub instance has metadata
# service authentication enabled.
#
# The OSS Quickstart ships with auth DISABLED, so a fresh local instance accepts
# unauthenticated writes and you may leave this blank. Set it when you enable
# auth, or when pointing at a shared or remote DataHub.
#
# To generate one:
#   1. Open the UI at http://localhost:9002 and sign in (default: datahub / datahub).
#   2. Go to Settings -> Access Tokens -> Generate new token.
#      If the page says tokens are disabled, auth is off and you do not need one.
#   3. Choose the shortest lifetime that covers your work, copy the token once
#      (it is not shown again), and paste it below.
#
# Scope it least-privilege, rotate it, never share it, never commit it.
DATAHUB_GMS_TOKEN=

# ---------------------------------------------------------------------------
# Language model: bring your own, or bring none
# ---------------------------------------------------------------------------
#
# Entirely optional. ModelGuard uses an LLM only to word the incident description
# and the impact report's assessment. Detection, severity, the blast radius, and
# the incident title never depend on it, and every number a human reads is
# measured, not generated. Leave all three blank and ModelGuard writes
# deterministic template prose instead. That is the out-of-the-box path.
#
# Set all three, or none. Setting some but not all fails the scan loudly rather
# than quietly downgrading to templates without telling you.
#
# Install the binding for the provider you pick:
#   pip install -e ".[anthropic]"   or   ".[openai]"   or   ".[google]"

# One of: anthropic, openai, google
MODELGUARD_LLM_PROVIDER=

# The provider's model id, verbatim. For example:
#   anthropic -> claude-opus-4-8
#   openai    -> gpt-5
#   google    -> gemini-2.5-pro
MODELGUARD_LLM_MODEL=

# The API key for the provider named above. Never passed on the command line:
# a credential in argv lands in your shell history and in the process table.
MODELGUARD_LLM_API_KEY=

# ---------------------------------------------------------------------------
# Scan tuning (optional; blank uses the default in modelguard/config.py)
# ---------------------------------------------------------------------------
#
# Setting one of these to a non-positive or unparseable value fails the scan
# loudly rather than falling back to the default: a typo in a threshold must not
# pass silently.

# How long a table may go unchanged before it counts as stale. Default: 6
MODELGUARD_FRESHNESS_SLA_HOURS=

# Lineage hops to traverse downstream of a failing table. Default: 3, the
# shortest path from a warehouse table to a model
# (dataset -> dataset -> mlFeature -> mlModel).
MODELGUARD_MAX_HOPS=

# Maximum lineage results to request in one traversal. Default: 500
MODELGUARD_LINEAGE_RESULT_CAP=

# Upstream column hops to traverse when the leakage detector hunts for a label.
# Default: 6. Higher than MODELGUARD_MAX_HOPS: a feature can be many
# derivations deep in a warehouse before it reaches the raw label column.
MODELGUARD_LEAKAGE_MAX_HOPS=

# The glossary term that declares a column to be a model's label. Default:
# urn:li:glossaryTerm:modelguard.label, which is the term `modelguard-seed`
# creates. On your own catalog that term does not exist, and leakage detection
# has nothing to look for until this points at the term your organization
# already uses for labels (create one in the UI under Glossary, apply it to the
# label column, and paste its URN here).
MODELGUARD_LABEL_TERM_URN=

# Column names `modelguard link --infer` falls back on when nothing in the graph
# declares a label, comma-separated. A guess, and the proposal says so; nothing
# is written without a human confirming it. Default: label, target, y, outcome,
# churned, is_churn, default_status, converted, fraud.
MODELGUARD_LABEL_COLUMN_NAMES=

# The classifications a model must not learn from, as comma-separated URNs.
# Either variable alone is enough: many catalogs classify columns with tags,
# many with glossary terms. Leave both empty and the sensitive-source check does
# not run, and every scan says so rather than reporting the model clean. There is
# deliberately no default: a guessed classification URN either matches nothing or
# matches a term that means something else in your catalog, and a false incident
# about a compliance exposure is the worst kind to be wrong about.
# Example: MODELGUARD_SENSITIVE_TAG_URNS=urn:li:tag:PII,urn:li:tag:Confidential
MODELGUARD_SENSITIVE_TERM_URNS=
MODELGUARD_SENSITIVE_TAG_URNS=

# The protected attributes a feature may end up standing in for, as
# comma-separated URNs (T-11). Separate from the sensitive lists above, and not
# a synonym: "restricted" is a handling rule (do not learn from this), while
# "protected attribute" is a legal category (race, sex, age, disability). Using
# one URN for both would report every PII column as a proxy candidate.
#
# Leave both empty and the check does not run, and every scan says so rather
# than reporting the model clean. No default, for the sensitive lists' reason
# and more so: a guessed URN here would invent a claim about discrimination out
# of a catalog that never made one. What this check reports is always a
# candidate for human review, never a determination that proxying occurs.
# Example: MODELGUARD_PROTECTED_ATTRIBUTE_TAG_URNS=urn:li:tag:ProtectedAttribute
MODELGUARD_PROTECTED_ATTRIBUTE_TERM_URNS=
MODELGUARD_PROTECTED_ATTRIBUTE_TAG_URNS=

# How far to look for the ancestor a feature and a protected attribute share.
# Lower than the leakage cap on purpose: a leak four joins back is still a leak,
# but a shared ancestor four joins back is most of a warehouse. Default: 3.
MODELGUARD_PROXY_MAX_HOPS=

# How `modelguard watch` writes its per-scan timing lines: text (default) for a
# human tailing the process, json for a deployment shipping them to a log
# pipeline that indexes fields. An unrecognised value is refused rather than
# quietly treated as text.
MODELGUARD_LOG_FORMAT=

# ---------------------------------------------------------------------------
# Argos, the desktop watchdog (optional)
# ---------------------------------------------------------------------------
#
# `modelguard watch --pet` and `modelguard companion` draw a small pixel dog on
# your desktop showing what the graph is doing. Everything below is optional:
# with none of it set, watch --pet still runs and reports one line per change in
# the terminal instead of opening a window.

# Where the window binary is, when it is not on PATH. Leave blank once
# `pip install "modelguard-datahub[pet]"` (macOS, Windows) or the .deb /
# .AppImage from the GitHub release (Linux) has installed `modelguard-argos`.
# Point it at argos/target/release/modelguard-argos to run a local build.
MODELGUARD_ARGOS_BIN=

# The DataHub *UI*, which is a different port from GMS above: on a Quickstart
# the UI is http://localhost:9002 while GMS is 8080. Used only to build the
# link behind "Open in DataHub" and the one on a speech bubble. No default and
# no guess: a wrong URL here is a link that opens somebody else's catalog, so
# with this blank the menu item simply says it is not configured.
MODELGUARD_DATAHUB_UI_URL=

# Whose assets `modelguard companion` watches, as an owner URN. Required by
# that command and by nothing else. An owner identifies an account, so there is
# no default: a guess would quietly watch the wrong person's assets, or all of
# them. Example: urn:li:corpuser:datahub or urn:li:corpGroup:analytics
MODELGUARD_COMPANION_OWNER=

# Most owned entities one companion sweep inspects. A threshold, not identity,
# so blank uses the default in modelguard/config.py. Default: 200
MODELGUARD_COMPANION_ENTITY_CAP=

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------

# Required to expose the MCP write tools (tags, terms, documents, ...).
TOOLS_IS_MUTATION_ENABLED=true
