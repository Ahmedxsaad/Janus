# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and personal environment (never commit these)
.env
*.pem
*.key

# Personal Claude Code settings (machine-specific, per person)
.claude/settings.local.json

# Editors and OS (personal, do not force on teammates)
.vscode/
.idea/
*.swp
.DS_Store

# Runtime artifacts
*.log
*.sqlite
*.db

# Rust build output for the Argos window. Cargo.lock is committed on purpose
# (this crate builds a binary, so the lock is what makes a release
# reproducible); target/ and Tauri's generated schemas are not.
argos/target/
argos/gen/

# mutmut's working copy (T-08): the mutated source tree and its per-run
# cache. Reproduced by `mutmut run`; only benchmarks/RESULTS.md's generated
# section is the durable artifact.
mutants/
